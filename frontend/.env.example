# Forge — Environment Variables
# Copy to .env.local for local development

# === Smart Account Kit (Passkey Wallet) ===

# Soroban testnet RPC
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# OZ Smart Account WASM hash (testnet)
NEXT_PUBLIC_ACCOUNT_WASM_HASH=3e51f5b222dec74650f0b33367acb42a41ce497f72639230463070e666abba2c

# WebAuthn verifier contract (testnet)
NEXT_PUBLIC_WEBAUTHN_VERIFIER=CATPTBRWVMH5ZCIKO5HN2F4FMPXVZEXC56RKGHRXCM7EEZGGXK7PICEH

# Native XLM SAC contract
NEXT_PUBLIC_NATIVE_CONTRACT=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# USDC SAC contract (testnet — Circle USDC)
NEXT_PUBLIC_USDC_CONTRACT=

# WebAuthn RP ID — must match the domain serving the app
# Use 'localhost' for local dev, your domain for production
NEXT_PUBLIC_WEBAUTHN_RP_ID=localhost

# === Fee Sponsoring (optional) ===
# Relayer URL for gasless transactions
NEXT_PUBLIC_RELAYER_URL=

# === Policy Contracts (optional, for spending limits) ===
NEXT_PUBLIC_SPENDING_LIMIT_POLICY=CBYLPYZGLQ6JVY2IQ5P23QLQPR3KAMMKMZLNWG6RUUKJDNYGPLVHK7U4

# === Backend ===
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SERVER_STELLAR_ADDRESS=
